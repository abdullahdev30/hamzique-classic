PAYLOAD_SECRET=mygeneratedsecret
# Payload is configured to use Postgres.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ecommerce-store
# Payload client pool size; Supabase transaction mode multiplexes these in serverless deployments.
DATABASE_POOL_MAX=5
# Recommended for Vercel: switches a Supabase pooler URL from session port 5432
# to transaction port 6543 without changing credentials.
USE_SUPABASE_TRANSACTION_POOLER=true
# Use runtime SSR instead of opening Supabase connections while Vercel builds routes.
SKIP_STATIC_GENERATION=true

COMPANY_NAME="Payload Inc."
TWITTER_CREATOR="@payloadcms"
TWITTER_SITE="https://nextjs.org/commerce"
SITE_NAME="Payload Commerce"

PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# The canonical deployment URL. Payload also trusts localhost:3000 for local admin access.
PRODUCTION_SERVER_URL=https://hamzique-classic.vercel.app

# Brevo SMTP. Add the same values to the Vercel project environment.
# Supabase Auth SMTP settings are separate and are not automatically exposed to Payload.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-login
SMTP_PASSWORD=your-brevo-smtp-key
SMTP_FROM_EMAIL=orders@example.com
SMTP_FROM_NAME="Hamzique Classic"
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
NEXT_PUBLIC_WHATSAPP_NUMBER=923001234567
NEXT_PUBLIC_WHATSAPP_LINK=https://wa.me/923001234567
NEXT_PUBLIC_CONTACT_PHONE="+44 (0) 121 663 0409"
NEXT_PUBLIC_CONTACT_CALL_LINK=tel:+441216630409
NEXT_PUBLIC_CONTACT_PHONE_TEXT="24/7 available customer service"
NEXT_PUBLIC_ORDER_TRACKING_URL=/find-order
NEXT_PUBLIC_ORDER_TRACKING_TEXT="Want to know if your order is processed and dispatched?"
NEXT_PUBLIC_SALES_EMAIL=sales@example.com
NEXT_PUBLIC_SALES_EMAIL_TEXT="Don't hesitate"
NEXT_PUBLIC_LIVE_CHAT_URL=/
NEXT_PUBLIC_LIVE_CHAT_TEXT="With our expert designer"
NEXT_PUBLIC_WHATSAPP_TEXT="You can whatsapp"
NEXT_PUBLIC_RETURN_ADDRESS_BRAND="Andaaz Fashion"
NEXT_PUBLIC_RETURN_ADDRESS_LINE_1="Unit 10 Watchmoor Trade Centre"
NEXT_PUBLIC_RETURN_ADDRESS_LINE_2="Watchmoor rd, Camberley"
NEXT_PUBLIC_RETURN_ADDRESS_LINE_3="Surrey GU15 3AJ"
NEXT_PUBLIC_RETURN_ADDRESS_COUNTRY="United Kingdom"
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_PINTEREST_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_TIKTOK_URL=

# Supabase Storage via S3-compatible API for Payload media uploads.
# Create a public bucket named "images", then copy endpoint, region, and keys
# from Supabase Storage > Configuration > S3.
S3_BUCKET=images
S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
S3_REGION=your-project-region
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
# Payload uses these S3-compatible credentials directly. Local media storage is disabled when all four values are set.
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=images
NEXT_PUBLIC_SUPABASE_STORAGE_PUBLIC_URL=https://your-project-ref.supabase.co/storage/v1/object/public

# Used to preview drafts
PREVIEW_SECRET=demo-draft-secret
